{
  "name": "@cat-cafe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "${NODE:-node} scripts/runtime-preflight.mjs",
    "dev": "${NODE:-node} ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "pnpm --dir ../shared build && tsc && node ./scripts/copy-marketplace-catalog-data.mjs",
    "prestart": "${NODE:-node} scripts/runtime-preflight.mjs",
    "start": "${NODE:-node} dist/index.js",
    "start:pm2": "${NODE:-node} ../../scripts/live-worktree-build-gate.mjs --artifact dist/index.js -- pnpm run build && pnpm run start",
    "test": "pnpm run build && CAT_CAFE_DISABLE_SHARED_STATE_PREFLIGHT=1 bash ./scripts/with-test-home.sh node --import $(pwd)/test/helpers/setup-cat-registry.js --test --test-timeout=60000 test/*.test.js test/**/*.test.js",
    "test:ci": "pnpm run test:lane:contracts && pnpm --dir ../shared build && pnpm --dir ../mcp-server build && pnpm run build && node scripts/run-test-lane.mjs --tier core",
    "test:public": "pnpm run test:ci",
    "test:lane:contracts": "node --test scripts/select-ci-tests.test.mjs scripts/run-test-lane.test.mjs",
    "test:lane:list": "node scripts/select-ci-tests.mjs --list",
    "test:lane:json": "node scripts/select-ci-tests.mjs --json",
    "test:lane:core": "node scripts/run-test-lane.mjs --tier core",
    "test:lane:redis": "node scripts/run-test-lane.mjs --tier redis",
    "test:lane:integration": "node scripts/run-test-lane.mjs --tier integration",
    "test:lane:slow": "node scripts/run-test-lane.mjs --tier slow",
    "test:lane:local-os": "node scripts/run-test-lane.mjs --tier local-os",
    "test:lane:external": "node scripts/run-test-lane.mjs --tier external",
    "test:antigravity-smoke": "RUN_ANTIGRAVITY_SMOKE=true pnpm run build && RUN_ANTIGRAVITY_SMOKE=true bash ./scripts/with-test-home.sh node --test test/antigravity-smoke.test.js",
    "rebuild-index": "node dist/scripts/rebuild-index.js",
    "project:init": "node dist/scripts/project-init.js",
    "test:redis": "bash ./scripts/with-test-home.sh bash ./scripts/run-isolated-redis-tests.sh",
    "test:redis:repeat": "bash ./scripts/with-test-home.sh bash ./scripts/run-isolated-redis-tests.sh --repeat 2",
    "test:redis:security": "bash ./scripts/run-isolated-redis-tests.sh bash ./scripts/run-redis-security-tests.sh",
    "test:integration": "bash ./scripts/with-test-home.sh node --test test/integration/*.test.js",
    "test:hygiene": "bash ./scripts/test-hygiene.test.sh",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cat-cafe/shared": "workspace:*",
    "@fastify/cookie": "9",
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "8",
    "@fastify/static": "7",
    "@fastify/websocket": "^10.0.0",
    "@huggingface/transformers": "^3",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@wecom/aibot-node-sdk": "1.0.4",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "cron-parser": "^5.5.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "fast-xml-parser": "^5.5.9",
    "fastify": "^4.25.0",
    "grammy": "^1.41.1",
    "http-proxy": "^1.18.1",
    "imapflow": "^1.2.10",
    "ioredis": "^5.3.0",
    "js-tiktoken": "^1.0.21",
    "node-pty": "1.2.0-beta.12",
    "nodemailer": "^6.9.16",
    "pino-roll": "^4.0.0",
    "puppeteer": "^24.37.2",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "silk-wasm": "^3.7.1",
    "smol-toml": "^1.6.0",
    "socket.io": "^4.7.0",
    "sqlite-vec": "^0.1.6",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yaml": "^2.8.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.17",
    "@types/puppeteer": "^7.0.4",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.0",
    "fast-check": "^4.5.3",
    "jsdom": "^28.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
